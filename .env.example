# NSE Scanner Hub — environment variables
# Copy these into Render's Environment settings (or a local .env). The site runs
# open (no login) until GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are both set.

# --- Google login (required to enable protection) ---
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Authorized redirect URI must be:  https://YOUR-SITE.onrender.com/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Selected users (the guest list) ---
# Comma-separated emails allowed to sign in. Leave empty to allow ANY verified
# Google account. You can also edit data/allowed_users.json instead.
ALLOWED_EMAILS=you@example.com,friend@example.com

# --- Session signing key ---
# Any long random string. Keeps users logged in across restarts.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Server ---
PORT=8080